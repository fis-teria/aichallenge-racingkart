<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="capture" default="false"/>
    <arg name="rosbag" default="false"/>
    <arg name="autostart_orchestrator_params" default="$(find-pkg-share autostart_orchestrator_py)/config/autostart_orchestrator.param.yaml"/>
    <!-- Normal races arm motion-affecting planners only at the official Start. -->
    <!-- SafetyGate overrides this to Ready,Start because its test clock starts before sync Start. -->
    <arg name="race_arm_on_vehicle_state" default="Start"/>
    <arg name="autostart_debug_visualization" default="true"/>
    <!-- Keep the orchestrator process alive on success (so it will not terminate the entire launch). -->
    <arg name="exit_on_finish" default="false"/>

    <!-- Adaptors for AWSIM -->
    <group>
        <include file="$(find-pkg-share aichallenge_awsim_adapter)/launch/aichallenge_awsim_adapter.launch.xml"/>
    </group>

	<!-- AWSIM only: auto request initialpose/control (+ optional capture/rosbag) -->
	  <node pkg="autostart_orchestrator_py" exec="autostart_orchestrator_node.py" name="autostart_orchestrator" output="both">
	  <param from="$(var autostart_orchestrator_params)"/>
	  <param name="enable_capture" value="$(var capture)"/>
	  <param name="enable_rosbag" value="$(var rosbag)"/>
	  <param name="exit_on_finish" value="$(var exit_on_finish)"/>
	  <param name="race_arm_on_vehicle_state" value="$(var race_arm_on_vehicle_state)"/>
	  <param name="enable_debug_visualization" value="$(var autostart_debug_visualization)"/>
	</node>
</launch>
