<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="param_file" default="$(find-pkg-share hybrid_control_mux)/config/hybrid_control_mux.param.yaml"/>
  <arg name="recovery_enabled" default="false"/>
  <arg name="require_safety_constraint" default="false"/>
  <arg name="input_mpc_cmd" default="/hybrid_control/mpc/control_cmd"/>
  <arg name="input_pure_pursuit_cmd" default="/hybrid_control/pure_pursuit/control_cmd"/>
  <arg name="input_pure_pursuit_tracking_status" default="/hybrid_control/pure_pursuit/tracking_status"/>
  <arg name="input_pure_pursuit_command_envelope" default="/hybrid_control/pure_pursuit/command_envelope"/>
  <arg name="input_state_lattice_control_cmd" default="/hybrid_control/state_lattice/control_cmd"/>
  <arg name="state_lattice_instant_control_enabled" default="false"/>
  <arg name="input_free_run_execution_ack" default="/hybrid_control/pure_pursuit/free_run_execution_ack"/>
  <arg name="input_free_run_source_key" default="/hybrid_control/pure_pursuit/free_run_source_key"/>
  <arg name="free_run_live_exact_observe_enabled" default="false"/>
  <arg name="free_run_live_exact_pre_ack_hold_enabled" default="false"/>
  <arg name="free_run_live_exact_evidence_timeout_sec" default="0.12"/>
  <arg name="free_run_source_provenance_timeout_sec" default="1.5"/>
  <arg name="input_recovery_cmd" default="/hybrid_control/recovery/control_cmd"/>
  <arg name="input_recovery_status" default="/wall_recovery/status"/>
  <arg name="input_recovery_permit" default="/wall_recovery/permit"/>
  <arg name="input_external_safety_status" default="/wall_recovery/external_safety_status"/>
  <arg name="input_safety_constraint" default="/overtake/safety_constraint"/>
  <arg name="input_overtake_plan" default="/overtake/plan"/>
  <arg name="input_mpc_health" default="/mpc/speed_profile_debug"/>
  <arg name="input_race_armed" default="/overtake/race_armed"/>
  <arg name="input_awsim_state" default="/awsim/state"/>
  <arg name="output_control_cmd" default="/control/command/control_cmd"/>
  <arg name="output_debug" default="/hybrid_control_mux/debug"/>
  <arg name="output_controller_tracking_status" default="/hybrid_control/controller_tracking_status"/>
  <arg name="output_motion_authority_grant" default="/hybrid_control/motion_authority_grant"/>

  <node pkg="hybrid_control_mux" exec="hybrid_control_mux_node.py"
        name="hybrid_control_mux_node" output="screen">
    <param from="$(var param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="recovery_enabled" value="$(var recovery_enabled)"/>
    <param name="require_safety_constraint" value="$(var require_safety_constraint)"/>
    <param name="state_lattice_instant_control_enabled" value="$(var state_lattice_instant_control_enabled)"/>
    <param name="free_run_live_exact_observe_enabled" value="$(var free_run_live_exact_observe_enabled)"/>
    <param name="free_run_live_exact_pre_ack_hold_enabled" value="$(var free_run_live_exact_pre_ack_hold_enabled)"/>
    <param name="free_run_live_exact_evidence_timeout_sec" value="$(var free_run_live_exact_evidence_timeout_sec)"/>
    <param name="free_run_source_provenance_timeout_sec" value="$(var free_run_source_provenance_timeout_sec)"/>
    <remap from="input/mpc_control_cmd" to="$(var input_mpc_cmd)"/>
    <remap from="input/pure_pursuit_control_cmd" to="$(var input_pure_pursuit_cmd)"/>
    <remap from="input/pure_pursuit_tracking_status" to="$(var input_pure_pursuit_tracking_status)"/>
    <remap from="input/pure_pursuit_command_envelope" to="$(var input_pure_pursuit_command_envelope)"/>
    <remap from="input/state_lattice_control_cmd" to="$(var input_state_lattice_control_cmd)"/>
    <remap from="input/free_run_execution_ack" to="$(var input_free_run_execution_ack)"/>
    <remap from="input/free_run_source_key" to="$(var input_free_run_source_key)"/>
    <remap from="input/recovery_control_cmd" to="$(var input_recovery_cmd)"/>
    <remap from="input/recovery_status" to="$(var input_recovery_status)"/>
    <remap from="input/recovery_permit" to="$(var input_recovery_permit)"/>
    <remap from="input/external_safety_status" to="$(var input_external_safety_status)"/>
    <remap from="input/safety_constraint" to="$(var input_safety_constraint)"/>
    <remap from="input/overtake_plan" to="$(var input_overtake_plan)"/>
    <remap from="input/mpc_health" to="$(var input_mpc_health)"/>
    <remap from="input/race_armed" to="$(var input_race_armed)"/>
    <remap from="input/awsim_state" to="$(var input_awsim_state)"/>
    <remap from="output/control_cmd" to="$(var output_control_cmd)"/>
    <remap from="output/debug" to="$(var output_debug)"/>
    <remap from="output/controller_tracking_status" to="$(var output_controller_tracking_status)"/>
    <remap from="output/motion_authority_grant" to="$(var output_motion_authority_grant)"/>
  </node>
</launch>
