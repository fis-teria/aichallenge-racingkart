<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="true"/>
  <arg name="use_overtake_planner" default="true"/>
  <arg name="config_path" default="$(find-pkg-share delay_aware_mpc_ros)/config/delay_aware_config.yaml"/>
  <arg name="ref_vel_path" default="$(find-pkg-share delay_aware_mpc_ros)/config/ref_vel.yaml"/>
  <arg name="delay_enabled" default="true"/>
  <arg name="delay_mode" default="state_shift_with_steer_lag"/>
  <arg name="steering_delay_sec" default="0.20"/>
  <arg name="prediction_dt" default="0.02"/>
  <arg name="steering_time_constant_sec" default="0.30"/>
  <arg name="wheelbase" default="1.087"/>
  <arg name="use_reference_time_shift" default="true"/>
  <arg name="use_steering_status" default="true"/>
  <arg name="steering_status_timeout_sec" default="0.20"/>
  <arg name="use_yaw_rate_fallback" default="true"/>
  <arg name="use_command_history_fallback" default="true"/>
  <arg name="input_control_cmd_raw" default="/control/command/control_cmd_raw"/>
  <arg name="min_velocity_for_yaw_prediction" default="0.20"/>
  <arg name="debug_publish_period_sec" default="0.25"/>
  <arg name="output_control_cmd" default="/control/command/control_cmd"/>
  <arg name="output_raw_control_cmd" default="/control/command/control_cmd_raw"/>
  <arg name="output_mpc_predicted_horizon" default="/mpc/predicted_horizon"/>
  <arg name="overtake_horizon_points" default="50"/>
  <arg name="overtake_mpc_health_solve_time_warn_ms" default="80.0"/>

  <!-- localization odomを遅れ補償して、既存MPCが読む代替odomトピックを作る。 -->
  <node pkg="delay_aware_mpc_ros" exec="delay_compensated_odometry_node"
        name="delay_compensated_odometry" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="enabled" value="$(var delay_enabled)"/>
    <param name="mode" value="$(var delay_mode)"/>
    <param name="steering_delay_sec" value="$(var steering_delay_sec)"/>
    <param name="prediction_dt" value="$(var prediction_dt)"/>
    <param name="steering_time_constant_sec" value="$(var steering_time_constant_sec)"/>
    <param name="wheelbase" value="$(var wheelbase)"/>
    <param name="use_reference_time_shift" value="$(var use_reference_time_shift)"/>
    <param name="use_steering_status" value="$(var use_steering_status)"/>
    <param name="steering_status_timeout_sec" value="$(var steering_status_timeout_sec)"/>
    <param name="use_yaw_rate_fallback" value="$(var use_yaw_rate_fallback)"/>
    <param name="use_command_history_fallback" value="$(var use_command_history_fallback)"/>
    <param name="input_control_cmd_raw_topic" value="$(var input_control_cmd_raw)"/>
    <param name="min_velocity_for_yaw_prediction" value="$(var min_velocity_for_yaw_prediction)"/>
    <param name="debug_publish_period_sec" value="$(var debug_publish_period_sec)"/>
  </node>

  <!-- MPC本体は既存実装を再利用し、入力odomだけ補償済みトピックへ差し替える。 -->
  <node pkg="delay_aware_mpc_ros" exec="run_delay_aware_mpc_controller.bash"
        name="delay_aware_mpc_controller" output="screen"
        args="--config_path $(var config_path)
              --ref_vel_path $(var ref_vel_path)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="use_boost_acceleration" value="false"/>
    <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <param name="use_stats" value="false"/>
    <remap from="/localization/kinematic_state" to="/delay_aware_mpc/localization/kinematic_state"/>
    <remap from="/control/command/control_cmd" to="$(var output_control_cmd)"/>
    <remap from="/control/command/control_cmd_raw" to="$(var output_raw_control_cmd)"/>
    <remap from="/mpc/predicted_horizon" to="$(var output_mpc_predicted_horizon)"/>
  </node>

  <group if="$(var use_overtake_planner)">
    <!-- OvertakePlannerも同じ補償済みodomを見ることで、MPCと判断基準を揃える。 -->
    <include file="$(find-pkg-share overtake_planner)/launch/overtake_planner.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="input_odom" value="/delay_aware_mpc/localization/kinematic_state"/>
      <arg name="horizon_points" value="$(var overtake_horizon_points)"/>
      <arg name="mpc_health_solve_time_warn_ms" value="$(var overtake_mpc_health_solve_time_warn_ms)"/>
    </include>
  </group>
</launch>
