<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="input_odom" default="/localization/kinematic_state"/>
  <arg name="param_path" default="$(find-pkg-share overtake_planner)/config/overtake_planner.param.yaml"/>

  <node pkg="overtake_planner" exec="overtake_planner_node"
        name="overtake_planner_node" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param from="$(var param_path)"/>
    <remap from="/localization/kinematic_state" to="$(var input_odom)"/>
  </node>
</launch>
