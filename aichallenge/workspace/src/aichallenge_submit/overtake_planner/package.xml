<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>overtake_planner</name>
  <version>0.1.0</version>
  <description>Non-learning overtake and blocked-traffic planner for the racing kart MPC stack.</description>
  <maintainer email="codex@example.invalid">Codex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>autoware_auto_planning_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>multi_purpose_mpc_ros_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>v2x_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
